; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Bastion Bomber"
config/description="Deploy bomber swarms and bring down the island fortress."
config/version="1.13.0 - Bastion"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0.11, 0.37, 0.65, 1)
boot_splash/stretch_mode=4
boot_splash/image="res://assets/ui/splash.png"
config/icon="res://assets/planes/bomber.png"
boot_splash/minimum_display_time=1800

[autoload]

GameConfig="*res://scripts/game_config.gd"
Settings="*res://scripts/settings.gd"
Playtest="*res://scripts/playtest.gd"

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/size/window_width_override=576
window/size/window_height_override=1024
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/size/resizable=true
window/handheld/orientation=1

